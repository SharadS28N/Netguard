# Netguard Backend Configuration Template
# Instructions: Copy this file to .env and fill in your actual values.
# DO NOT COMMIT THE .env FILE TO VERSION CONTROL.

# 1. MongoDB Atlas URI
# Obtain from: https://cloud.mongodb.com/
# Create a free cluster -> Connect -> Drivers -> Python
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=netguard

# 2. Flask Application Settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_your_own_secure_key_here

# 3. Environment & Logging
# Options: development, production, testing
ENVIRONMENT=production
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 4. Hugging Face Integration (Optional)
# If you want to host your model on Hugging Face Hub
# Obtain token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_write_token_here
HF_MODEL_ID=your_username/netguard-evil-twin-model

# 5. Frontend Origins
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
