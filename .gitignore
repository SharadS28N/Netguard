# Netguard Backend .gitignore

# 1. Environment variables (SENSITIVE)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 2. Python environment & dependencies
__pycache__/
*.py[cod]
*$py.class
venv/
env/
ENV/
build/
dist/
*.egg-info/

# 3. Model files & Data (EXCLUDE LARGE/STALE BINARIES)
# We recommend hosting these on Hugging Face
backend/models/*.pkl
backend/models/*.joblib
backend/models/*.h5
backend/models/*.pt
backend/models/*.pth
backend/data/
backend/visualizations/*.png
backend/visualizations/*.json

# 4. Logs & Temporal files
*.log
.pytest_cache/
.coverage
htmlcov/
nosetests.xml
coverage.xml
*.db
*.sqlite

# 5. OS specific files
.DS_Store
Thumbs.db
desktop.ini

# 6. Node modules (for frontend, if in the same repo)
node_modules/
.next/
out/
